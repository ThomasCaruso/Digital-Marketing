# FORM — environment variable scaffold
# Never commit real secrets.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GLM / Z.ai
ZAI_API_KEY=
GLM_MODEL=glm-5.3-flash

# Commerce provider (Rakuten Advertising — server-side only, NEVER commit real values)
# Bearer token for api.linksynergy.com. Generate it on the developer portal
# "Applications" page (developers.rakutenadvertising.com) — the documented
# static retrieval path. Regenerating a token expires the previous one.
RAKUTEN_BEARER_TOKEN=
# Optional Token API credential pair (same Applications page) for programmatic
# token retrieval/refresh instead of a static token. Leave empty when
# RAKUTEN_BEARER_TOKEN is set.
RAKUTEN_CLIENT_ID=
RAKUTEN_CLIENT_SECRET=
# Optional: override the Token API endpoint (verify against the portal before use).
RAKUTEN_TOKEN_URL=

# Hosted VTON benchmark/fallback
FASHN_API_KEY=

# Self-hosted VTON
VTON_BASE_URL=
VTON_API_TOKEN=

# Premium media (future)
HIGGSFIELD_API_KEY=

# Runtime
APP_ENV=development
